{
  "name": "sendtrace",
  "version": "1.0.0",
  "private": true,
  "description": "SendTrace — painel da régua de pós-venda: em qual etapa cada pedido está, o que cada etapa envia e quantos clientes há em cada uma.",
  "type": "module",
  "scripts": {
    "setup": "node --env-file-if-exists=.env server/setup.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "senha": "node --env-file-if-exists=.env server/senha.js",
    "api": "node --env-file-if-exists=.env api/servidor.js",
    "api:dev": "node --env-file-if-exists=.env --watch api/servidor.js"
  },
  "//scripts": "env-file-if-exists (não env-file): fora do container o .env manda; dentro dele não existe arquivo nenhum e as variáveis vêm do ambiente. O mesmo comando serve nos dois lugares.",
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.11.0",
    "imapflow": "^1.7.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1"
  }
}
