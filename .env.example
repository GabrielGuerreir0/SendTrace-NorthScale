# Copie para .env e preencha. NUNCA versione o .env — ele tem senha.
#
# ── API do SendTrace (de onde vêm TODOS os números) ───────────────────
#
# A régua e a fila são lidas destas rotas, não do banco. Sem as três
# variáveis o painel sobe, avisa no console e mostra "sem conexão".
#
# A API identifica a conta pelo E-MAIL de um usuário do painel. O
# token JWT é obtido em /api/auth/token/ e fica só no servidor: o
# navegador nunca o recebe.
#
# NO DOCKER esta variável é IGNORADA de propósito: os composes sobem a
# API deste repositório junto com o painel e apontam um para o outro
# pela rede interna (http://api:4400 / http://sendtrace-painel-api:4400).
# Ela só vale no `npm start` fora do container — ou, em produção, se
# você preencher API_URL no .env para usar uma instância externa.
API_URL=http://187.127.255.132:8000

# Quanto tempo a fila baixada vale antes de ser buscada de novo. Um
# snapshot faz ~8 perguntas sobre a mesma fila; a janela evita baixá-la
# oito vezes. Subir isto deixa a tela mais "velha"; descer, mais pesada.
API_CACHE_MS=4000

# Teto de registros baixados de /api/disparos/. A API não agrega, então
# medir a fila é baixá-la. Passando disto o painel mostra um aviso de
# que está falando de uma PARTE — nunca corta em silêncio.
API_FILA_MAX=20000

# Corte de paciência com a API, em ms.
API_TIMEOUT_MS=20000

# ── A API deste repositório (api/servidor.js) ────────────────────────
#
# Assina os tokens de login. OBRIGATÓRIO e com no mínimo 32 caracteres:
# sem ele a API se recusa a subir — um padrão embutido deixaria qualquer
# leitor do código forjar um token de administrador. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (Em produção não precisa: o deploy gera um sozinho na primeira vez e
# grava no .env do servidor.)
API_JWT_SEGREDO=

# Porta e interface do `npm run api` FORA do container. No Docker os
# composes forçam 0.0.0.0:4400, senão a API responderia só ao loopback
# do próprio container.
API_PORT=4400
API_HOST=127.0.0.1

# Validade dos tokens: access em minutos, refresh em horas.
API_ACCESS_MIN=60
API_REFRESH_H=12

# Token de SERVIÇO para integrações (o chatbot de suporte usa este, em vez
# de logar com e-mail/senha). Opcional: vazio = desligado. Mínimo 32
# caracteres; gere com o mesmo comando do segredo acima. Quem entra por ele
# LÊ tudo e grava o resumo de chat, mas nunca é administrador — vazou,
# troque esta linha e pronto.
API_TOKEN_SERVICO=

# ── Banco (só login e usuários do painel) ────────────────────────────
#
# A API expõe /api/usuarios/ apenas para LEITURA — não dá para criar,
# promover nem emitir senha provisória por ela. Por isso o acesso ao
# painel continua no Postgres.
#
# USO LOCAL (npm start): preencha DATABASE_URL e ignore as DB_* abaixo.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# PRODUÇÃO (docker-compose.prod.yml): deixe DATABASE_URL VAZIA e
# preencha as DB_* — o compose monta a URL sozinho.
#
# ARMADILHA: dentro de um container, 127.0.0.1 é o PRÓPRIO container, e
# a conexão nem sai à procura do Postgres. Use:
#   · o NOME DO CONTAINER do banco (sendtrace-postgres), quando ele
#     também roda em Docker e vocês compartilham uma rede;
#   · host.docker.internal, quando o Postgres está instalado no host
#     (exige extra_hosts no compose).
DB_HOST=sendtrace-postgres
DB_PORTA=5432
DB_NOME=sendtrace
DB_USUARIO=sendtrace
DB_SENHA=

# Rede Docker onde o container do banco já vive. Confira com:
#   docker network ls | grep sendtrace
DOCKER_REDE_BANCO=sendtrace_default

PORT=4300
# 127.0.0.1 no uso local. Em container o compose força 0.0.0.0, senão o
# servidor responderia só ao loopback do próprio container.
HOST=127.0.0.1

# Imagem que o compose de produção sobe. O deploy grava a tag do commit
# aqui; para voltar a uma versão anterior, troque pela tag antiga.
IMAGEM=

# Acima de quantos minutos em 'processando' um pedido conta como TRAVADO.
LOCK_TIMEOUT_MIN=10

# Fuso do corte diário em "Entradas na régua".
TZ_PAINEL=America/Sao_Paulo

# Só ligue se o certificado TLS não validar na sua rede.
DB_SSL_INSECURE=false

# ── Acesso ao painel ─────────────────────────────────────────────────
# Administrador inicial. Só é usado no PRIMEIRO `npm run setup`, quando
# ainda não existe nenhum usuário. Se você não definir, o setup sorteia
# uma senha e mostra no terminal uma única vez.
# A senha é sempre provisória: o painel exige uma nova no primeiro acesso.
ADMIN_EMAIL=voce@suaempresa.com
ADMIN_SENHA=

# Quantas horas uma sessão dura antes de exigir login de novo.
SESSAO_HORAS=12

# Mensagem crua do Postgres nas respostas de erro. Deixe false em
# produção: a mensagem carrega nome de coluna e trecho de consulta.
ERROS_DETALHADOS=false

# ── Convite por e-mail ───────────────────────────────────────────────
# Opcional. Sem isto o painel funciona igual: a senha provisória aparece
# na tela para quem criou a conta repassar como quiser.
NOME_PAINEL=SendTrace

# Endereço público do painel, usado no link do e-mail. Enquanto estiver
# vazio, o link sai do endereço por onde você acessou o painel — então
# só preencha quando o domínio estiver decidido.
PAINEL_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Remetente. Aceita "Nome <caixa@dominio.com>".
SMTP_DE=SendTrace <nao-responda@suaempresa.com>
# Deixe vazio para decidir pela porta (465 = TLS direto, 587 = STARTTLS).
SMTP_SEGURO=

# Dias que a senha provisória vale antes de expirar.
CONVITE_DIAS=7

# ── Troca da linha de mensagens (1 / 2 / 3) ──────────────────────────
# Webhook do n8n que troca qual versão da copy está ativa. O token fica
# SÓ aqui: o navegador nunca o recebe, quem chama o n8n é este servidor.
N8N_TROCAR_LINHA_URL=https://n8n.thenorthscales.com/webhook/trocar-linha
N8N_TOKEN=

# ── Central de E-mail IA (chat com o banco + geração de rascunho) ────
# Chave da API Anthropic. Usada só nos dois recursos que chamam Claude:
# o chat (POST /api/chat) e a geração de rascunho de resposta
# (POST /api/resposta). Sem ela, os dois devem falhar com erro
# amigável, não quebrar a tela.
ANTHROPIC_API_KEY=
