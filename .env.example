# Copie para .env e preencha. NUNCA versione o .env — ele tem senha.
#
# ── Banco ────────────────────────────────────────────────────────────
#
# USO LOCAL (npm start): preencha DATABASE_URL e ignore as DB_* abaixo.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# PRODUÇÃO (docker-compose.prod.yml): deixe DATABASE_URL VAZIA e
# preencha as DB_* — o compose monta a URL sozinho.
#
# ARMADILHA: dentro de um container, 127.0.0.1 é o PRÓPRIO container, e
# a conexão nem sai à procura do Postgres. Use:
#   · o NOME DO CONTAINER do banco (sendtrace-postgres), quando ele
#     também roda em Docker e vocês compartilham uma rede;
#   · host.docker.internal, quando o Postgres está instalado no host
#     (exige extra_hosts no compose).
DB_HOST=sendtrace-postgres
DB_PORTA=5432
DB_NOME=sendtrace
DB_USUARIO=sendtrace
DB_SENHA=

# Rede Docker onde o container do banco já vive. Confira com:
#   docker network ls | grep sendtrace
DOCKER_REDE_BANCO=sendtrace_default

PORT=4300
# 127.0.0.1 no uso local. Em container o compose força 0.0.0.0, senão o
# servidor responderia só ao loopback do próprio container.
HOST=127.0.0.1

# Imagem que o compose de produção sobe. O deploy grava a tag do commit
# aqui; para voltar a uma versão anterior, troque pela tag antiga.
IMAGEM=

# Acima de quantos minutos em 'processando' um pedido conta como TRAVADO.
LOCK_TIMEOUT_MIN=10

# Fuso do corte diário em "Entradas na régua".
TZ_PAINEL=America/Sao_Paulo

# Só ligue se o certificado TLS não validar na sua rede.
DB_SSL_INSECURE=false

# ── Acesso ao painel ─────────────────────────────────────────────────
# Administrador inicial. Só é usado no PRIMEIRO `npm run setup`, quando
# ainda não existe nenhum usuário. Se você não definir, o setup sorteia
# uma senha e mostra no terminal uma única vez.
# A senha é sempre provisória: o painel exige uma nova no primeiro acesso.
ADMIN_EMAIL=voce@suaempresa.com
ADMIN_SENHA=

# Quantas horas uma sessão dura antes de exigir login de novo.
SESSAO_HORAS=12

# Mensagem crua do Postgres nas respostas de erro. Deixe false em
# produção: a mensagem carrega nome de coluna e trecho de consulta.
ERROS_DETALHADOS=false

# ── Convite por e-mail ───────────────────────────────────────────────
# Opcional. Sem isto o painel funciona igual: a senha provisória aparece
# na tela para quem criou a conta repassar como quiser.
NOME_PAINEL=SendTrace

# Endereço público do painel, usado no link do e-mail. Enquanto estiver
# vazio, o link sai do endereço por onde você acessou o painel — então
# só preencha quando o domínio estiver decidido.
PAINEL_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Remetente. Aceita "Nome <caixa@dominio.com>".
SMTP_DE=SendTrace <nao-responda@suaempresa.com>
# Deixe vazio para decidir pela porta (465 = TLS direto, 587 = STARTTLS).
SMTP_SEGURO=

# Dias que a senha provisória vale antes de expirar.
CONVITE_DIAS=7

# ── Troca da linha de mensagens (1 / 2 / 3) ──────────────────────────
# Webhook do n8n que troca qual versão da copy está ativa. O token fica
# SÓ aqui: o navegador nunca o recebe, quem chama o n8n é este servidor.
N8N_TROCAR_LINHA_URL=https://n8n.thenorthscales.com/webhook/trocar-linha
N8N_TOKEN=
